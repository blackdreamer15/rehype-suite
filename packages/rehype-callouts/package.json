{
	"name": "@blackdreamer15/rehype-callouts",
	"version": "0.1.0",
	"description": "Transform GitHub-style alert blockquotes into CSS-free HAST callouts.",
	"author": "Jessy Justice Julien Baki",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"rehype",
		"unified",
		"markdown",
		"callouts",
		"github-alerts"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/blackdreamer15/rehype-suite.git",
		"directory": "packages/rehype-callouts"
	},
	"homepage": "https://github.com/blackdreamer15/rehype-suite/tree/main/packages/rehype-callouts#readme",
	"bugs": {
		"url": "https://github.com/blackdreamer15/rehype-suite/issues"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/hast": "^3.0.4"
	},
	"devDependencies": {
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"typescript": "^5.7.2",
		"unified": "^11.0.0",
		"vitest": "^2.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
